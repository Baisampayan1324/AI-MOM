# Environment Configuration for Advanced Meeting Minutes System v2.0

# ===================================
# API Keys (Required)
# ===================================
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ===================================
# Primary AI Models
# ===================================
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=openai/gpt-4o-mini

# ===================================
# Additional Models (5-Model System)
# ===================================
GROQ_MODEL_2=llama-3.1-70b-versatile
OPENROUTER_MODEL_2=anthropic/claude-3-haiku
OPENROUTER_MODEL_3=google/gemini-flash-1.5

# ===================================
# Server Configuration
# ===================================
HOST=localhost
PORT=8000

# ===================================
# Transcription Settings
# ===================================
# Default transcription language (leave blank for auto-detect, or use 'en', 'es', 'fr', etc.)
TRANSCRIPTION_LANGUAGE=en

# Whisper model for file uploads (options: tiny, base, small, medium, large)
# Larger = more accurate but slower
FILE_WHISPER_MODEL=base

# Whisper model for real-time transcription (options: tiny, tiny.en, base, base.en, small, small.en)
# Recommendation: base.en for good balance of speed and accuracy
REALTIME_WHISPER_MODEL=base.en

# ===================================
# PyAnnote Speaker Diarization
# ===================================
# HuggingFace token for pyannote-audio models
# Get from: https://huggingface.co/settings/tokens
# Required model licenses:
#   - https://huggingface.co/pyannote/speaker-diarization-3.1
#   - https://huggingface.co/pyannote/segmentation-3.0
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Minimum seconds of audio to buffer before running diarization
# Higher = more accurate but less frequent updates, Lower = more frequent but may be less accurate
# Default: 10.0
DIARIZATION_MIN_SECONDS=10.0

# ===================================
# Real-time Transcription Tuning
# ===================================
# Minimum seconds to buffer before first transcription
# Default: 1.0
REALTIME_MIN_SECONDS=1.0

# Maximum seconds to buffer (force flush upper bound)
# Default: 3.5
REALTIME_MAX_SECONDS=3.5

# Energy threshold for silence detection
# Lower = more sensitive to quiet audio, Higher = only detect louder speech
# Default: 4e-5
REALTIME_SILENCE_THRESHOLD=4e-5

# Seconds of tail to check for silence
# Default: 0.3
REALTIME_SILENCE_TAIL=0.3

# Use FP16 for faster Whisper processing (requires GPU with CUDA)
# 0 = disabled (default), 1 = enabled
# Default: 0
REALTIME_WHISPER_FP16=0

# ===================================
# Optional Settings
# ===================================
# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===================================
# MongoDB Speaker Diarization Storage
# ===================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_mom
MONGODB_DIARIZATION_COLLECTION=speaker_diarization
ENABLE_MONGODB_DIARIZATION_STORAGE=false